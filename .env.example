# Clé API pour les résumés (optionnel — sans clé, extrait RSS brut)
# Gemini (recommandé si vous l'utilisez déjà sur SPIKE)
GEMINI_API_KEY=

# Ou OpenAI
# OPENAI_API_KEY=

# Fournisseur : gemini | openai | none
AI_PROVIDER=gemini

# Modèle (laisser vide pour le défaut du fournisseur)
AI_MODEL=

# Langue des résumés
SUMMARY_LANGUAGE=fr
